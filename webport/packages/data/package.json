{
  "name": "@wafers/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Game configuration: types, zod schemas, and JSON converted from the Unity ScriptableObject assets",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "scripts": {
    "convert": "node scripts/convert-unity-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
